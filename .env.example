# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://vault_user:vault_pass@localhost:5432/devsloop_vault"

# ===========================================
# APPLICATION
# ===========================================
PORT=3001
NODE_ENV=staging

# ===========================================
# JWT / AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# FILE UPLOAD
# ===========================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_DEST=./uploads

# ===========================================
# PASSWORD RESET
# ===========================================
PASSWORD_RESET_EXPIRES_HOURS=1
FRONTEND_URL=http://localhost:3000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# CACHE (In-Memory)
# ===========================================
CACHE_TTL=300

# ===========================================
# QUEUE / BACKGROUND JOBS (pg-boss)
# ===========================================
# Queue-level retry configuration
# Number of retry attempts for failed jobs at queue level
QUEUE_RETRY_LIMIT=1
# Delay between retries in milliseconds
QUEUE_RETRY_DELAY=2000
# Job expiration time in seconds (default: 1 hour)
QUEUE_EXPIRE_SECONDS=3600

# Job-level retry configuration (can override queue defaults)
# Number of retry attempts for individual jobs
JOB_RETRY_LIMIT=1
# Delay between job retries in milliseconds
JOB_RETRY_DELAY=2000
# Job expiration time in seconds (default: 1 hour)
JOB_EXPIRE_SECONDS=3600

# ===========================================
# EMAIL / RESEND
# ===========================================
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender information
# NOTE: FROM_EMAIL domain must be verified in the Resend dashboard.
# For local testing without a verified domain, use onboarding@resend.dev
FROM_EMAIL=noreply@devsloop.com
FROM_NAME=DevsLoop Vault

# ===========================================
# GOOGLE OAUTH
# ===========================================
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=your_google_callback_url_here

# ===========================================
# CONTACT / LANDING PAGE FORMS
# ===========================================
# Inbox that receives contact & booking form submissions
CONTACT_RECIPIENT_EMAIL=hello@arslanihsan.com

# Comma-separated origins for CORS — add all landing page domains in production
# Example: FRONTEND_URL=https://arslanihsan.com,https://www.arslanihsan.com
