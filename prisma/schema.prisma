generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(cuid())
  email                    String         @unique @db.VarChar(320)
  name                     String         @db.VarChar(255)
  personalEmail            String?        @db.VarChar(320)
  departments              String[]       @default([])
  designation              String?        @db.VarChar(255)
  joiningDate              DateTime?
  leaveDate                DateTime?
  baseSalaryMonthly        Decimal?       @db.Decimal(12, 2)
  casualLeaveBalance       Int            @default(0)
  sickLeaveBalance         Int            @default(0)
  annualLeaveBalance       Int            @default(0)
  wfhAllowancePerMonth     Int            @default(1)
  allowMaternityLeave      Boolean        @default(false)
  allowWeddingLeave        Boolean        @default(false)
  allowUmrahHajjLeave      Boolean        @default(false)
  allowOtherLeave          Boolean        @default(false)
  allowExtraWfh            Boolean        @default(false)
  lunchEnabled             Boolean        @default(true)
  avatarUrl                String?        @db.VarChar(2048)
  bio                      String?        @db.Text
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  emailVerified            Boolean        @default(false)
  password                 String         @db.VarChar(255)
  passwordResetExpires     DateTime?
  passwordResetToken       String?        @db.VarChar(512)
  refreshToken             String?
  reviewedAt               DateTime?
  approvalStatus           ApprovalStatus @default(PENDING)
  reviewedById             String?
  rejectionReason          String?        @db.VarChar(1000)
  emailVerificationExpires DateTime?
  emailVerificationToken   String?        @db.VarChar(512)
  isSystem                 Boolean        @default(false)
  welcomeEmailSentAt       DateTime?
  mustChangePassword       Boolean        @default(false)

  // Personal Information
  dateOfBirth              DateTime?
  cnic                     String?   @db.VarChar(15)
  gender                   Gender?
  religion                 String?   @db.VarChar(100)
  sect                     String?   @db.VarChar(100)
  fatherName               String?   @db.VarChar(255)
  emergencyContactName     String?   @db.VarChar(255)
  emergencyContactPhone    String?   @db.VarChar(20)
  emergencyContactRelation String?   @db.VarChar(100)
  maritalStatus            String?   @db.VarChar(50)
  mobileNumber             String?   @db.VarChar(20)
  bankName                 String?   @db.VarChar(255)
  iban                     String?   @db.VarChar(50)
  currentAddress           String?   @db.VarChar(1000)
  permanentAddress         String?   @db.VarChar(1000)
  educationLevel           String?   @db.VarChar(100)
  highestQualification     String?   @db.VarChar(255)
  institutionName          String?   @db.VarChar(255)
  fieldOfStudy             String?   @db.VarChar(255)
  employeeReference        String?   @db.VarChar(255)
  areaOfExpertise          String?   @db.VarChar(255)
  workingDays              String?   @db.VarChar(100)
  teamLead                 String?   @db.VarChar(255)
  cityOfResidence          String?   @db.VarChar(100)
  accountHolderName        String?   @db.VarChar(255)
  bankCode                 String?   @db.VarChar(50)
  province                 String?   @db.VarChar(100)
  swiftCode                String?   @db.VarChar(20)
  incomeTaxAmount          Decimal?  @db.Decimal(12, 2)

  // Employment Information
  employeeId               String?                    @db.VarChar(50)
  employeeType             EmployeeType?
  employeeStatus           EmployeeStatus             @default(ACTIVE)
  probationPeriod          Int?
  workingModel             String?                    @db.VarChar(255)
  workingMode              WorkingMode?
  workingShift             String?                    @db.VarChar(100)
  grantedAclEntries        AclEntry[]                 @relation("AclEntryGranter")
  aclEntries               AclEntry[]                 @relation("AclEntryUser")
  auditLogs                AuditLog[]
  bookmarks                Bookmark[]
  contributions            Contribution[]             @relation("UserContributions")
  reviewedContributions    Contribution[]             @relation("ReviewerContributions")
  assignedProjects         UserProject[]              @relation("UserProjectAssigner")
  userProjects             UserProject[]              @relation("UserProjectUser")
  assignedRoles            UserRoleAssignment[]       @relation("UserRoleAssignmentAssigner")
  userRoleAssignments      UserRoleAssignment[]       @relation("UserRoleAssignmentUser")
  reviewedBy               User?                      @relation("ReviewedUsers", fields: [reviewedById], references: [id])
  reviewedUsers            User[]                     @relation("ReviewedUsers")
  userWarnings             UserWarning[]              @relation("UserWarnings")
  createdWarnings          UserWarning[]              @relation("WarningCreatedBy")
  assetAssignments         AssetAssignment[]          @relation("AssetAssignmentUser")
  reportedAssetIssues      AssetIssue[]               @relation("AssetIssueReporter")
  leaveRequests            LeaveRequest[]             @relation("EmployeeLeaveRequests")
  managedLeaveRequests     LeaveRequest[]             @relation("ReportingManagerLeaveRequests")
  teamLeadReviews          LeaveRequest[]             @relation("TeamLeadLeaveReviews")
  hrReviews                LeaveRequest[]             @relation("HrLeaveReviews")
  hrAppliedLeaves          LeaveRequest[]             @relation("HrAppliedLeaveRequests")
  hrModifiedLeaves         LeaveRequest[]             @relation("HrModifiedLeaveRequests")
  leaveBalances            LeaveBalance[]             @relation("UserLeaveBalances")
  wfhMonthlyUsages         WfhMonthlyUsage[]          @relation("UserWfhMonthlyUsage")
  worklogs                 Worklog[]
  missedReminders          WorklogMissedReminder[]
  reimbursementRequests    ReimbursementRequest[]     @relation("EmployeeReimbursements")
  hrReviewedReimbursements ReimbursementRequest[]     @relation("HrReviewedReimbursements")
  processedReimbursements  ReimbursementRequest[]     @relation("ProcessedReimbursements")
  processedInstallments    ReimbursementInstallment[] @relation("ProcessedInstallments")
  projectBookmarks         ProjectBookmark[]
  createdProjects          Project[]                  @relation("ProjectCreatedBy")
  projectStakeholderOf     ProjectStakeholder[]
  payrollProfile           PayrollProfile?
  payrollLines             PayrollLine[]
  payrollPeriodsLocked     PayrollPeriod[]            @relation("PayrollPeriodLockedBy")
  payrollAdjustmentAudits  PayrollAdjustmentAudit[]

  @@index([departments])
  @@index([employeeId])
  @@index([passwordResetToken])
  @@index([emailVerificationToken])
  @@index([approvalStatus])
  @@index([isSystem, approvalStatus])
  @@map("users")
}

model Project {
  id                   String               @id @default(cuid())
  name                 String               @db.VarChar(255)
  clientName           String               @db.VarChar(255)
  domain               String?              @db.VarChar(255)
  description          String?              @db.VarChar(2000)
  startDate            DateTime
  endDate              DateTime?
  techStack            String[]             @default([])
  confidentialityLevel ConfidentialityLevel @default(MEDIUM)
  channelUrl           String?              @db.VarChar(2048)

  // Project Hub — Narrative
  executiveSummary    String?  @db.Text
  executiveSummaryUrl String?  @db.VarChar(2048)
  problemStatement    String?  @db.Text
  problemStatementUrl String?  @db.VarChar(2048)
  deliverables        String[] @default([])

  // Project Hub — Lifecycle
  status ProjectStatus @default(DISCOVERY)

  // Project Hub — Stakeholders
  clientContactName  String? @db.VarChar(255)
  clientContactEmail String? @db.VarChar(320)

  // Project Hub — Security (JSON: { mfa, encryptionLevel, ssl, securityDetails? })
  securityProtocols Json?

  // Project Hub — Resource Links
  stagingUrl       String? @db.VarChar(2048)
  liveUrl          String? @db.VarChar(2048)
  documentationUrl String? @db.VarChar(2048)
  figmaUrl         String? @db.VarChar(2048)
  githubUrl        String? @db.VarChar(2048)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy       User?                   @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  bookmarks       ProjectBookmark[]
  stakeholders    ProjectStakeholder[]
  contributions   Contribution[]
  userProjects    UserProject[]
  worklogs        Worklog[]
  missedReminders WorklogMissedReminder[]
  milestones      Milestone[]

  @@index([name])
  @@index([clientName])
  @@index([domain])
  @@index([confidentialityLevel])
  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model UserProject {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  assignedAt DateTime @default(now())
  assignedBy String?
  assigner   User?    @relation("UserProjectAssigner", fields: [assignedBy], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation("UserProjectUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@index([assignedBy])
  @@map("user_projects")
}

model ProjectBookmark {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_bookmarks")
}

enum ProjectStakeholderRole {
  MANAGER
  LEAD
  OBSERVER
}

model ProjectStakeholder {
  id        String                 @id @default(cuid())
  projectId String
  userId    String
  role      ProjectStakeholderRole
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
  @@index([projectId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_stakeholders")
}

model Contribution {
  id                   String                   @id @default(cuid())
  authorId             String
  projectId            String
  toolsAndTechnologies String[]                 @default([])
  outcome              String?
  learnings            String?
  visibility           VisibilityLevel          @default(PRIVATE)
  status               ContributionStatus       @default(DRAFT)
  reviewerId           String?
  reviewerComment      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  problem              String
  solution             String
  rejectionCount       Int                      @default(0)
  reviewedAt           DateTime?
  /// Full-text search vector — maintained by database trigger, do not set manually
  searchVector         Unsupported("tsvector")? @map("search_vector")
  bookmarks            Bookmark[]
  author               User                     @relation("UserContributions", fields: [authorId], references: [id], onDelete: Cascade)
  project              Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer             User?                    @relation("ReviewerContributions", fields: [reviewerId], references: [id])

  @@index([authorId])
  @@index([projectId])
  @@index([status])
  @@index([visibility])
  @@index([reviewerId])
  @@index([createdAt])
  @@index([authorId, status])
  @@index([projectId, status])
  @@map("contributions")
}

model Worklog {
  id         String        @id @default(cuid())
  userId     String
  projectId  String
  date       DateTime      @db.Date
  content    String        @db.Text
  isLeave    Boolean       @default(false)
  aiScore    Int?
  aiFeedback String?       @db.Text
  status     WorklogStatus @default(NEEDS_REVIEW)
  manDay     Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, date, projectId])
  @@index([userId])
  @@index([projectId])
  @@index([date])
  @@index([userId, date])
  @@index([projectId, date])
  @@map("worklogs")
}

model PublicHoliday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("public_holidays")
}

model SystemConfig {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(1000)
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model WorklogMissedReminder {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  date       DateTime @db.Date
  lastSentAt DateTime
  sentCount  Int      @default(1)
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, date])
  @@index([resolved, date])
  @@index([userId])
  @@index([projectId])
  @@map("worklog_missed_reminders")
}

model Bookmark {
  id             String       @id @default(cuid())
  userId         String
  contributionId String
  createdAt      DateTime     @default(now())
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contributionId])
  @@index([userId])
  @@index([contributionId])
  @@map("bookmarks")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(255)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(255)
  changes    Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([timestamp])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Entity {
  id           String       @id @default(cuid())
  name         String       @unique @db.VarChar(100)
  displayName  String       @db.VarChar(255)
  description  String?      @db.VarChar(1000)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  aclEntries   AclEntry[]
  roleEntities RoleEntity[]

  @@index([isActive])
  @@map("entities")
}

model Role {
  id                  String               @id @default(cuid())
  name                String               @unique @db.VarChar(100)
  displayName         String               @db.VarChar(255)
  description         String?              @db.VarChar(1000)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  systemRole          Boolean              @default(false)
  roleEntities        RoleEntity[]
  userRoleAssignments UserRoleAssignment[]

  @@index([isActive])
  @@index([systemRole])
  @@map("roles")
}

model RoleEntity {
  id        String   @id @default(cuid())
  roleId    String
  entityId  String
  actions   String[] @default([])
  createdAt DateTime @default(now())
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, entityId])
  @@index([roleId])
  @@index([entityId])
  @@map("role_entities")
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  isPrimary  Boolean  @default(false)
  assigner   User?    @relation("UserRoleAssignmentAssigner", fields: [assignedBy], references: [id])
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation("UserRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedBy])
  @@index([userId, isPrimary])
  @@map("user_roles")
}

model AclEntry {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  grantedAt DateTime @default(now())
  grantedBy String?
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  granter   User?    @relation("AclEntryGranter", fields: [grantedBy], references: [id])
  user      User     @relation("AclEntryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
  @@index([grantedBy])
  @@map("acl_entries")
}

model UserWarning {
  id          String      @id @default(cuid())
  userId      String
  createdById String
  message     String      @db.VarChar(2000)
  warningType WarningType @default(MINOR)
  createdAt   DateTime    @default(now())
  user        User        @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("WarningCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
  @@index([createdById])
  @@map("user_warnings")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultantPayMode {
  FIXED
  DAILY_RATE
  HOURLY_RATE
}

enum WarningType {
  INFO
  MINOR
  MAJOR
  CRITICAL
}

enum ConfidentialityLevel {
  LOW
  MEDIUM
  HIGH
}

enum VisibilityLevel {
  PRIVATE
  INTERNAL
  PUBLIC_ELIGIBLE
}

enum ContributionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Asset Management
// ─────────────────────────────────────────────────────────────────────────────

model AssetType {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@index([isActive])
  @@map("asset_types")
}

model Asset {
  id               String            @id @default(cuid())
  assetName        String            @db.VarChar(255)
  assetTypeId      String
  serialNumber     String            @unique @db.VarChar(255)
  purchaseDate     DateTime?
  status           AssetStatus       @default(AVAILABLE)
  notes            String?           @db.Text
  totalQuantity    Int               @default(1)
  assignedQuantity Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assetType        AssetType         @relation(fields: [assetTypeId], references: [id])
  assignments      AssetAssignment[]
  history          AssetHistory[]
  issues           AssetIssue[]

  @@index([serialNumber])
  @@index([status])
  @@index([assetTypeId])
  @@map("assets")
}

model AssetAssignment {
  id             String    @id @default(cuid())
  assetId        String
  userId         String
  assignmentDate DateTime  @default(now())
  assignedById   String?
  returnedAt     DateTime?
  createdAt      DateTime  @default(now())
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user           User      @relation("AssetAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@index([assetId, userId])
  @@map("asset_assignments")
}

model AssetHistory {
  id          String         @id @default(cuid())
  assetId     String
  eventType   AssetEventType
  performedBy String
  employeeId  String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([createdAt])
  @@map("asset_history")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  LOST
  RETIRED
}

enum AssetEventType {
  ASSET_CREATED
  ASSIGNED
  RETURNED
  STATUS_CHANGED
  REPAIR_REPORTED
  REPAIR_RESOLVED
}

model AssetIssue {
  id           String             @id @default(cuid())
  assetId      String
  reportedById String
  issueType    AssetIssueType
  description  String             @db.Text
  priority     AssetIssuePriority @default(MEDIUM)
  status       AssetIssueStatus   @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  asset        Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reportedBy   User               @relation("AssetIssueReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([reportedById])
  @@index([status])
  @@map("asset_issues")
}

enum AssetIssueType {
  HARDWARE
  SOFTWARE
  OTHER
}

enum AssetIssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum AssetIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum LeaveType {
  CASUAL
  SICK
  HALF_DAY
  WFH
  MATERNITY
  WEDDING
  UMRAH_HAJJ
  OTHER
}

enum LeaveStatus {
  PENDING
  TEAM_LEAD_APPROVED
  TEAM_LEAD_REJECTED
  APPROVED
  REJECTED
  CANCELLED
  MODIFIED
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveCategory {
  PAID
  UNPAID
}

model LeaveRequest {
  id                    String         @id @default(cuid())
  employeeId            String
  reportingManagerId    String
  leaveType             LeaveType
  status                LeaveStatus    @default(PENDING)
  startDate             DateTime
  endDate               DateTime
  halfDayPeriod         HalfDayPeriod?
  daysConsumed          Decimal        @db.Decimal(4, 1)
  reason                String         @db.VarChar(2000)
  medicalCertificateUrl String?        @db.VarChar(2048)

  teamLeadId             String?
  teamLeadComment        String?   @db.VarChar(2000)
  teamLeadReviewedAt     DateTime?
  requiresClientApproval Boolean   @default(false)

  hrId         String?
  hrComment    String?   @db.VarChar(2000)
  hrReviewedAt DateTime?

  category          LeaveCategory?
  unpaidDays        Decimal        @default(0) @db.Decimal(4, 1)
  originalLeaveType LeaveType?

  /// Non-null when HR applied this leave directly on behalf of the employee (special leaves).
  appliedByHrId String?

  /// Non-null when HR modified this leave after it was created (date/type/status changes).
  modifiedByHrId     String?
  modifiedAt         DateTime?
  modificationReason String?   @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee         User  @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  reportingManager User  @relation("ReportingManagerLeaveRequests", fields: [reportingManagerId], references: [id])
  teamLead         User? @relation("TeamLeadLeaveReviews", fields: [teamLeadId], references: [id])
  hr               User? @relation("HrLeaveReviews", fields: [hrId], references: [id])
  appliedByHr      User? @relation("HrAppliedLeaveRequests", fields: [appliedByHrId], references: [id])
  modifiedByHr     User? @relation("HrModifiedLeaveRequests", fields: [modifiedByHrId], references: [id])

  @@index([employeeId])
  @@index([reportingManagerId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
  @@index([employeeId, status])
  @@index([status, leaveType])
  @@map("leave_requests")
}

model LeaveBalance {
  id            String   @id @default(cuid())
  userId        String
  year          Int
  casualBalance Decimal  @default(0) @db.Decimal(4, 1)
  sickBalance   Decimal  @default(0) @db.Decimal(4, 1)
  casualUsed    Decimal  @default(0) @db.Decimal(4, 1)
  sickUsed      Decimal  @default(0) @db.Decimal(4, 1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation("UserLeaveBalances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@index([year])
  @@map("leave_balances")
}

/// Monthly WFH usage tracker — stores approved and pending WFH days per employee
/// per calendar month. Used instead of live aggregation so that manual DB inserts
/// are reflected correctly.
model WfhMonthlyUsage {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int // 1 = January … 12 = December
  used      Decimal  @default(0) @db.Decimal(4, 1) // approved WFH days this month
  pending   Decimal  @default(0) @db.Decimal(4, 1) // in-flight (PENDING / TL_APPROVED) WFH days
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserWfhMonthlyUsage", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@map("wfh_monthly_usage")
}

model PayrollProfile {
  userId                   String             @id
  rentalAllowanceMonthly   Decimal?           @db.Decimal(12, 2)
  commuteAllowanceMonthly  Decimal?           @db.Decimal(12, 2)
  defaultConsultantPayMode ConsultantPayMode?
  defaultDailyRate         Decimal?           @db.Decimal(12, 2)
  defaultHourlyRate        Decimal?           @db.Decimal(12, 2)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payroll_profiles")
}

model PayrollPeriod {
  id                 String              @id @default(cuid())
  yearMonth          String              @unique @db.VarChar(7)
  status             PayrollPeriodStatus @default(DRAFT)
  lunchRatePerDay    Decimal             @default(200) @db.Decimal(12, 2)
  defaultTaxPercent  Decimal             @default(0) @db.Decimal(5, 2)
  lockedAt           DateTime?
  lockedById         String?
  lastExportChecksum Decimal?            @db.Decimal(18, 2)
  lastExportAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lines              PayrollLine[]
  lockedBy           User?               @relation("PayrollPeriodLockedBy", fields: [lockedById], references: [id])

  @@index([yearMonth])
  @@map("payroll_periods")
}

model PayrollLine {
  id                      String         @id @default(cuid())
  periodId                String
  userId                  String
  displayName             String         @db.VarChar(255)
  employeeCode            String?        @db.VarChar(50)
  departments             String[]       @default([])
  designation             String?        @db.VarChar(255)
  employeeType            EmployeeType?
  employeeStatus          EmployeeStatus
  baseSalaryMonthly       Decimal        @db.Decimal(12, 2)
  rentalAllowanceMonthly  Decimal        @default(0) @db.Decimal(12, 2)
  commuteAllowanceMonthly Decimal        @default(0) @db.Decimal(12, 2)

  extraWorkingDays        Int      @default(0)
  pendingWorkingDays      Int?
  lunchDaysOverride       Int?
  performanceBonus        Decimal  @default(0) @db.Decimal(12, 2)
  reimbursementManual     Decimal  @default(0) @db.Decimal(12, 2)
  includeHrReimbursements Boolean  @default(true)
  payViaRemittance        Boolean  @default(false)
  deductionTaxable        Decimal  @default(0) @db.Decimal(12, 2)
  deductionNonTaxable     Decimal  @default(0) @db.Decimal(12, 2)
  fines                   Decimal  @default(0) @db.Decimal(12, 2)
  loanDeduction           Decimal  @default(0) @db.Decimal(12, 2)
  advanceDeduction        Decimal  @default(0) @db.Decimal(12, 2)
  taxPercentOverride      Decimal? @db.Decimal(12, 2)

  consultantPayMode    ConsultantPayMode?
  contractedDailyRate  Decimal?           @db.Decimal(12, 2)
  contractedHourlyRate Decimal?           @db.Decimal(12, 2)
  hoursWorked          Decimal?           @db.Decimal(5, 1)

  standardWorkingDays  Int       @default(0)
  paidLeaveDays        Decimal   @default(0) @db.Decimal(5, 1)
  unpaidLeaveDays      Decimal   @default(0) @db.Decimal(5, 1)
  reimbursementFromHr  Decimal   @default(0) @db.Decimal(12, 2)
  overtimeEarnings     Decimal   @default(0) @db.Decimal(12, 2)
  basicProRated        Decimal   @default(0) @db.Decimal(12, 2)
  grossSalary          Decimal   @default(0) @db.Decimal(12, 2)
  foodDeduction        Decimal   @default(0) @db.Decimal(12, 2)
  taxDeduction         Decimal   @default(0) @db.Decimal(12, 2)
  unpaidLeaveDeduction Decimal   @default(0) @db.Decimal(12, 2)
  totalDeductions      Decimal   @default(0) @db.Decimal(12, 2)
  netSalary            Decimal   @default(0) @db.Decimal(12, 2)
  calculatedAt         DateTime?

  period PayrollPeriod            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits PayrollAdjustmentAudit[]

  @@unique([periodId, userId])
  @@index([periodId])
  @@index([userId])
  @@map("payroll_lines")
}

model PayrollAdjustmentAudit {
  id        String      @id @default(cuid())
  lineId    String
  field     String      @db.VarChar(64)
  oldValue  String?     @db.VarChar(500)
  newValue  String?     @db.VarChar(500)
  actorId   String
  createdAt DateTime    @default(now())
  line      PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  actor     User        @relation(fields: [actorId], references: [id])

  @@index([lineId])
  @@index([actorId])
  @@map("payroll_adjustment_audits")
}

model ReimbursementRequest {
  id                String                      @id @default(cuid())
  employeeId        String
  reimbursementType ReimbursementType
  amount            Decimal                     @db.Decimal(12, 2)
  description       String                      @db.VarChar(2000)
  receiptUrl        String?                     @db.VarChar(2048)
  merchantName      String?                     @db.VarChar(255)
  transactionDate   DateTime                    @db.Date
  status            ReimbursementStatus         @default(PENDING)
  processingType    ReimbursementProcessingType @default(SALARY_ADJUSTMENT)
  otherComments     String?                     @db.VarChar(1000)

  // Medical-specific fields
  patientName         String?              @db.VarChar(255)
  patientRelationship PatientRelationship?
  treatmentType       TreatmentType?
  hospitalName        String?              @db.VarChar(255)

  // HR Review Fields
  hrId           String?
  hrComment      String?   @db.VarChar(2000)
  hrReviewedAt   DateTime?
  approvedAmount Decimal?  @db.Decimal(12, 2)

  // Processing Fields
  processedAt     DateTime?
  processedById   String?
  processingNotes String?   @db.VarChar(1000)
  salaryMonth     String?   @db.VarChar(7) // YYYY-MM format

  // Installment Plan
  hasInstallmentPlan Boolean @default(false)
  totalInstallments  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     User                       @relation("EmployeeReimbursements", fields: [employeeId], references: [id], onDelete: Cascade)
  hrReviewer   User?                      @relation("HrReviewedReimbursements", fields: [hrId], references: [id])
  processedBy  User?                      @relation("ProcessedReimbursements", fields: [processedById], references: [id])
  installments ReimbursementInstallment[]

  @@index([employeeId])
  @@index([status])
  @@index([reimbursementType])
  @@index([transactionDate])
  @@index([hrId])
  @@index([salaryMonth])
  @@index([employeeId, status])
  @@index([status, reimbursementType])
  @@map("reimbursement_requests")
}

model ReimbursementInstallment {
  id              String            @id @default(cuid())
  reimbursementId String
  installmentNo   Int
  scheduledMonth  String            @db.VarChar(7) // YYYY-MM format
  amount          Decimal           @db.Decimal(12, 2)
  status          InstallmentStatus @default(PENDING)
  processedAt     DateTime?
  processedById   String?
  processingNotes String?           @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reimbursement ReimbursementRequest @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  processedBy   User?                @relation("ProcessedInstallments", fields: [processedById], references: [id])

  @@unique([reimbursementId, installmentNo])
  @@index([reimbursementId])
  @@index([scheduledMonth, status])
  @@map("reimbursement_installments")
}

enum InstallmentStatus {
  PENDING
  PROCESSED
}

enum WorklogStatus {
  VALID
  NEEDS_REVIEW
}

enum ReimbursementType {
  MEDICAL
  FOOD
  FUEL_TRAVELLING
  IT_GADGETS
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum ReimbursementProcessingType {
  SALARY_ADJUSTMENT
  SEPARATE_PAYMENT
}

enum PatientRelationship {
  SELF
  PARENT
  SPOUSE
  CHILD
}

enum TreatmentType {
  HOSPITALIZATION
  MEDICINE
  CONSULTATION
  LAB_TESTS
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeType {
  FULL_TIME
  CONSULTANT
  CONTRACT
  INTERN
}

enum PayrollPeriodStatus {
  DRAFT
  LOCKED
}

enum EmployeeStatus {
  ACTIVE
  HOLD
  FREEZE
  DEACTIVATED
}

enum WorkingMode {
  HYBRID
  WORK_FROM_HOME
  ONSITE
}

// =============================================================================
// Project Hub Enums
// =============================================================================

enum ProjectStatus {
  DISCOVERY
  IN_DEVELOPMENT
  UAT
  LIVE
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClientSignOff {
  PENDING
  YES
  NO
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EncryptionLevel {
  NONE
  BASIC
  ADVANCED
}

// =============================================================================
// Milestone Model
// =============================================================================

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  name          String          @db.VarChar(255)
  description   String?         @db.Text
  startDate     DateTime
  endDate       DateTime?
  status        MilestoneStatus @default(PLANNED)
  clientSignOff ClientSignOff   @default(PENDING)
  deliverables  String[]        @default([])
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprints Sprint[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("milestones")
}

// =============================================================================
// Sprint Model
// =============================================================================

model Sprint {
  id           String       @id @default(cuid())
  milestoneId  String
  name         String       @db.VarChar(255)
  description  String?      @db.Text
  startDate    DateTime
  endDate      DateTime?
  status       SprintStatus @default(PLANNED)
  deliverables String[]     @default([])
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("sprints")
}
