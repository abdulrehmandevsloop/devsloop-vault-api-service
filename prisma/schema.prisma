// Prisma Schema for DevsLoop Vault
// Knowledge Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  EMPLOYEE
  TEAM_LEAD
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConfidentialityLevel {
  LOW
  MEDIUM
  HIGH
}

enum VisibilityLevel {
  PRIVATE
  INTERNAL
  PUBLIC_ELIGIBLE
}

enum ContributionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TagCategory {
  TECH
  SKILL
  DOMAIN
}

// ============================================
// MODELS
// ============================================

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String
  password                 String
  roleId                   String? // Assigned by admin after approval
  department               String?
  avatarUrl                String?
  emailVerified            Boolean   @default(false)
  hasAccess                Int       @default(1) // 1 = has access, 0 = no access
  refreshToken             String?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Admin review fields
  approvalStatus  ApprovalStatus @default(PENDING)
  reviewedById    String? // Admin who reviewed (approved/rejected)
  reviewedAt      DateTime? // When admin took action
  rejectionReason String? // Optional reason if rejected

  // Relations
  contributions         Contribution[]       @relation("UserContributions")
  reviewedContributions Contribution[]       @relation("ReviewerContributions")
  bookmarks             Bookmark[]
  auditLogs             AuditLog[]
  reviewedBy            User?                @relation("ReviewedUsers", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedUsers         User[]               @relation("ReviewedUsers")
  // ACL Relations
  userRoleAssignments   UserRoleAssignment[]
  aclEntries            AclEntry[]
  role                  Role?                @relation("UserRole", fields: [roleId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([department])
  @@index([emailVerified])
  @@index([passwordResetToken])
  @@index([emailVerificationToken])
  @@index([approvalStatus])
  @@index([roleId])
  @@index([hasAccess])
  @@map("users")
}

model Project {
  id                   String               @id @default(cuid())
  name                 String
  clientName           String
  domain               String
  description          String
  startDate            DateTime
  endDate              DateTime?
  techStack            String[]             @default([])
  confidentialityLevel ConfidentialityLevel @default(MEDIUM)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relations
  contributions Contribution[]

  @@index([name])
  @@index([clientName])
  @@index([domain])
  @@index([confidentialityLevel])
  @@map("projects")
}

model Contribution {
  id                String             @id @default(cuid())
  userId            String
  projectId         String
  roleInProject     String
  task              String
  action            String             @db.Text
  toolsTechnologies String[]           @default([])
  outcome           String?            @db.Text
  keyLearnings      String?            @db.Text
  attachments       String[]           @default([])
  visibilityLevel   VisibilityLevel    @default(PRIVATE)
  status            ContributionStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  reviewComments    String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  user      User              @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer  User?             @relation("ReviewerContributions", fields: [reviewerId], references: [id], onDelete: SetNull)
  tags      ContributionTag[]
  bookmarks Bookmark[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([visibilityLevel])
  @@index([reviewerId])
  @@index([submittedAt])
  @@index([createdAt])
  // Composite index for common queries
  @@index([userId, status])
  @@index([projectId, status])
  @@map("contributions")
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  category  TagCategory
  createdAt DateTime    @default(now())

  // Relations
  contributions ContributionTag[]

  @@index([category])
  @@index([name])
  @@map("tags")
}

model ContributionTag {
  contributionId String
  tagId          String
  assignedAt     DateTime @default(now())

  // Relations
  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contributionId, tagId])
  @@index([tagId])
  @@map("contribution_tags")
}

model Bookmark {
  id             String   @id @default(cuid())
  userId         String
  contributionId String
  createdAt      DateTime @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([userId, contributionId])
  @@index([userId])
  @@index([contributionId])
  @@map("bookmarks")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([timestamp])
  // Composite index for entity lookups
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================
// ACL MODELS - Access Control List (Entity-Based)
// ============================================

model Entity {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "user", "project", "task", "report"
  displayName String // e.g., "User", "Project", "Task", "Report"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roleEntities RoleEntity[]
  aclEntries   AclEntry[]

  @@index([name])
  @@index([isActive])
  @@map("entities")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roleEntities        RoleEntity[]
  userRoleAssignments UserRoleAssignment[]
  users               User[]               @relation("UserRole")

  @@index([name])
  @@index([isActive])
  @@index([isSystem])
  @@map("roles")
}

model RoleEntity {
  id        String   @id @default(cuid())
  roleId    String
  entityId  String
  createdAt DateTime @default(now())

  // Relations
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([roleId, entityId])
  @@index([roleId])
  @@index([entityId])
  @@map("role_entities")
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String? // Admin who assigned the role

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ACL Entry - Direct user-entity permission (Access Control List)
model AclEntry {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  grantedAt DateTime @default(now())
  grantedBy String? // Admin who granted the permission

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
  @@map("acl_entries")
}
